# ============================================================
# Variáveis de ambiente do Servidor de Licenças MobilixStore
# Configure essas mesmas variáveis no painel do Render
# ============================================================

# Banco de dados PostgreSQL (crie um banco gratuito no Render e copie a "Internal Database URL")
DATABASE_URL=

# Gmail para envio automático de emails
# IMPORTANTE: use uma "Senha de App" do Gmail, não a senha normal da conta
# Como gerar: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Mercado Pago
MP_ACCESS_TOKEN=

# Link de download do sistema (ex: página do site com o instalador)
LINK_DOWNLOAD_SISTEMA=https://mobilixsaas.com.br/download

# Porta do servidor (o Render define automaticamente, pode deixar assim)
PORT=3002
